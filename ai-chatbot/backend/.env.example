# Copie este arquivo para .env e preencha com seus valores.
# O .env real não vai para o git.

# URL base de uma API de IA compatível com OpenAI (o backend anexa /chat/completions).
# Provedoras conhecidas:
#   Z.AI (padrão):  https://api.z.ai/api/paas/v4
#   OpenAI:         https://api.openai.com/v1
#   OpenRouter:     https://openrouter.ai/api/v1
#   Groq:           https://api.groq.com/openai/v1
#   Google Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
#   Mistral:        https://api.mistral.ai/v1
#   DeepSeek:       https://api.deepseek.com/v1
AI_BASE_URL=https://api.z.ai/api/paas/v4

# Chave da API da provedora configurada acima
#   Z.AI:  https://z.ai/manage-apikey/apikey-list
#   OpenAI: https://platform.openai.com/api-keys
#   OpenRouter: https://openrouter.ai/keys
#   Groq:  https://console.groq.com/keys
#   Gemini: https://aistudio.google.com/apikey
AI_API_KEY=

# Modelo usado na conversa (opcional; padrão: glm-4.5-flash)
# Exemplos: gpt-4o-mini (OpenAI) | deepseek/deepseek-chat-v3:free (OpenRouter)
#           llama-3.3-70b-versatile (Groq) | gemini-2.0-flash (Gemini)
# AI_MODEL=glm-4.5-flash
